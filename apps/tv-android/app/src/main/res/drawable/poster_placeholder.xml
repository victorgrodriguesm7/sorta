<?xml version="1.0" encoding="utf-8"?>
<!--
  Layered placeholder shown in two cases:
    1. While Glide is fetching the poster (briefly visible).
    2. For media rows with no local poster file *and* no TMDB
       fallback URL (fully visible until the user replaces it).

  Background fills the card; a film-strip icon is centered and
  inset so it never bleeds to the card edge.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background" />
            <stroke
                android:width="1dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center"
        android:drawable="@drawable/ic_film" />
</layer-list>
