<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Local app theme. Inherits AndroidX Leanback's dark TV theme and
         tints the window background with our palette. The parent name
         is `Theme.Leanback` from the leanback library; we deliberately
         use a different local name so this style doesn't shadow it. -->
    <style name="Theme.SortaTv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
</resources>
