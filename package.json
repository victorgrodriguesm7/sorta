{
  "name": "sorta",
  "private": true,
  "version": "0.1.0",
  "description": "Sorta — workspace root. Each app lives under apps/.",
  "scripts": {
    "dev": "pnpm --filter @sorta/desktop dev",
    "tauri": "pnpm --filter @sorta/desktop tauri",
    "tauri:dev": "pnpm --filter @sorta/desktop tauri dev",
    "build": "pnpm --filter @sorta/desktop build",
    "test": "pnpm --filter @sorta/desktop test",
    "test:watch": "pnpm --filter @sorta/desktop test:watch",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --lib",
    "lint": "pnpm --filter @sorta/desktop lint",
    "format": "pnpm --filter @sorta/desktop format",
    "typecheck": "pnpm --filter @sorta/desktop exec tsc -b --noEmit"
  }
}
